# ── GCP ──────────────────────────────────────────────────────────────
PROJECT_ID=adp-413110
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Dedicated sites load balancer (provision once: python -m scripts.provision_sites_lb)
SITES_LB_PREFIX=webdeploy-sites
SITES_DEMO_HOST=demo.digitaldatatest.com
SITES_APPS_DOMAIN=digitaldatatest.com
SITES_DNS_ZONE=digitaldatatest-com

# Legacy load balancers — existing sites stay there; nothing new is added
DEMO_DOMAIN=digitaldatatest.com
DEMO_URL_MAP_NAME=test-lb
PROD_URL_MAP_NAME=websites-urlmap-prod
PROD_GLOBAL_IP_NAME=websites-lb-ip-prod
PROD_HTTPS_PROXY_NAME=websites-https-proxy-prod

# Prod infrastructure toggles
PROD_AUTO_REGISTER_DOMAINS=false
PROD_AUTO_CREATE_DNS_ZONE=true
PROD_AUTO_CREATE_SSL_CERT=false

# Bucket
BUCKET_LOCATION=US
BUCKET_CORS_MAX_AGE=3600

# CDN
CDN_DEFAULT_TTL=3600
CDN_MAX_TTL=86400
CDN_CLIENT_TTL=3600
CDN_NEGATIVE_CACHING=true
CDN_NEGATIVE_CACHING_TTL=120

# ── AI Validation (Claude primary, OpenRouter free fallback) ─────────
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Email (Gmail API via service account) ────────────────────────────
GMAIL_DELEGATED_USER=ahmed@bestoftours.co.uk
NOTIFICATION_FROM_EMAIL=webdeploy@bestoftours.co.uk
NOTIFICATION_TO_EMAILS=team@bestoftours.co.uk

# ── App ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
TEMP_DIR=./tmp
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/webdeploy.db
BUILD_TIMEOUT_SECONDS=300
PREVIEW_TIMEOUT_SECONDS=30
MAX_ZIP_SIZE_MB=500

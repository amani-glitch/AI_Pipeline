# ── GCP ──────────────────────────────────────────────────────────────
PROJECT_ID=adp-413110
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Dedicated sites load balancer (provision once: python -m scripts.provision_sites_lb)
SITES_LB_PREFIX=webdeploy-sites
SITES_DEMO_HOST=demo.digitaldatatest.com
SITES_APPS_DOMAIN=digitaldatatest.com
SITES_DNS_ZONE=digitaldatatest-com

# Legacy load balancers — existing sites stay there; nothing new is added
DEMO_DOMAIN=digitaldatatest.com
DEMO_URL_MAP_NAME=test-lb
PROD_URL_MAP_NAME=websites-urlmap-prod
PROD_GLOBAL_IP_NAME=websites-lb-ip-prod
PROD_HTTPS_PROXY_NAME=websites-https-proxy-prod

# Infrastructure toggles (prod websites AND Cloud Run websites with a domain)
# PROD_AUTO_REGISTER_DOMAINS gates every domain purchase: with it off the
# domain check always answers "owned" and /api/domains/register returns 403.
# A purchase additionally needs the user to confirm it in the deploy form.
PROD_AUTO_REGISTER_DOMAINS=true
PROD_AUTO_CREATE_DNS_ZONE=true
PROD_AUTO_CREATE_SSL_CERT=false

# WHOIS contact written into every domain the platform buys (Cloud Domains).
# Defaults in config.py already hold the company's standard details; override
# here only to register under different contact data.
DOMAINS_CONTACT_EMAIL=ahmed@bestoftours.co.uk
DOMAINS_CONTACT_NAME=Best of Tours SAS
DOMAINS_CONTACT_COMPANY=Best of Tours SAS
DOMAINS_CONTACT_PHONE=+44.7739634908
DOMAINS_CONTACT_ADDRESS=26 rue de la Calade
DOMAINS_CONTACT_CITY=Carpentras
DOMAINS_CONTACT_POSTAL_CODE=84200
DOMAINS_CONTACT_COUNTRY=FR
DOMAINS_CONTACT_PRIVACY=REDACTED_CONTACT_DATA

# Bucket
BUCKET_LOCATION=US
BUCKET_CORS_MAX_AGE=3600

# CDN
CDN_DEFAULT_TTL=3600
CDN_MAX_TTL=86400
CDN_CLIENT_TTL=3600
CDN_NEGATIVE_CACHING=true
CDN_NEGATIVE_CACHING_TTL=120

# ── AI Validation (Claude primary, OpenRouter free fallback) ─────────
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Email (Gmail API via service account) ────────────────────────────
GMAIL_DELEGATED_USER=ahmed@bestoftours.co.uk
NOTIFICATION_FROM_EMAIL=webdeploy@bestoftours.co.uk
NOTIFICATION_TO_EMAILS=team@bestoftours.co.uk

# ── App ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
TEMP_DIR=./tmp
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/webdeploy.db
BUILD_TIMEOUT_SECONDS=300
PREVIEW_TIMEOUT_SECONDS=30
MAX_ZIP_SIZE_MB=500

# ── Cloud Run websites ───────────────────────────────────────────────
CLOUDRUN_REGION=europe-west1
CLOUDRUN_MEMORY=512Mi
CLOUDRUN_CPU=1
CLOUDRUN_MAX_INSTANCES=10
CLOUDRUN_MIN_INSTANCES=0
CLOUDRUN_ARTIFACT_REPO=cloud-run-images
